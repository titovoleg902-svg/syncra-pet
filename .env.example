# Скопируйте этот файл в .env и заполните значения.
# Файл .env хранит секреты и НЕ попадает в git.

# Токен бота от @BotFather (выглядит как 1234567890:AAH...)
BOT_TOKEN=

# Публичный HTTPS-адрес Mini App.
# Telegram открывает Mini App только по https://
# Для теста на телефоне это адрес туннеля, например https://xxxx.trycloudflare.com
WEBAPP_URL=

# Ключ OpenAI — только на сервере (этап 6)
OPENAI_API_KEY=
